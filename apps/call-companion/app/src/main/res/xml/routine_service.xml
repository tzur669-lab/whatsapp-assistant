<?xml version="1.0" encoding="utf-8"?>
<!--
  Routines (0.13). Window changes only, so the service knows when a screen has
  settled; the package list is set at runtime to the routines' own apps, and
  every step checks the active window's app again before it acts. No key
  events. Text is set only through ACTION_SET_TEXT, with the text written into
  the routine (0.13.1).
  Unlocking with the stored PIN (0.17): flagRetrieveInteractiveWindows lets the
  service read the lock screen's keypad; canPerformGestures is on only to
  swipe the keypad up (0.17.1: ColorOS ignores the system's dismiss request)
  and to tap its keys (0.17.3: ColorOS accepts ACTION_CLICK on them and enters
  nothing). Those and the relock are the only
  gestures and the only extra global action (RoutineAccessibilityService
  press / swipeUp / relock, pinned by UnlockScanTest).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:packageNames="com.tzur.callcompanion"
    android:description="@string/routine_service_description" />
