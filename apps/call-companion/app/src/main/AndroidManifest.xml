<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the assistant's Worker. HTTPS only, every request signed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hold-to-record voice messages. Asked for at the first press, not at install. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Match a name to a contact. Read on the phone, never sent anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Place the call after the tap, from this SIM. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The call request appears over the lock screen; Android 14+ may ask for it in settings. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Action cards (PLAN §6.20): set an alarm or a timer in the clock app, after the claim. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Do-not-disturb and the ringer. The user grants it in settings; until then the card says so. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!--
      Phone reads (PLAN §6.21): recent SMS, read on the phone only when the
      assistant asks, minimized here — no numbers, no one-time codes.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!--
      The call log (2026-10-06): "who called me", and the missed calls in the
      morning digest. Read on the phone; names and times leave it, never a number.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!--
      The weather and the Shabbat times where the phone is (0.8): approximate
      location only, read when a message is sent, rounded to about a kilometre.
      Asked for once; off in the menu at any time.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Which installed apps an "open the app" card can match, by their launcher
      labels — read on the phone, never sent anywhere.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Both are used when present; neither is required to install. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
      Nothing here is backed up or transferred: the chat history, the device id
      and the Keystore alias stay on this phone (data_extraction_rules.xml).
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_assistant"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share to the assistant (0.11): text only. It waits in the chat for
              the user's request; nothing is sent until the user sends it, and
              the server treats it as someone else's words.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
              The default digital assistant (0.11): a long press on home opens
              the chat, ready for a tap on 🎤. Nothing records without that tap.
            -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The home-screen widget (0.11): the newest reminder, and type / talk. -->
        <receiver
            android:name=".AssistantWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Quotas: what Groq reports and what the server counts. Opened by the app only. -->
        <activity
            android:name=".QuotaActivity"
            android:exported="false" />

        <!-- The guide and the list of commands. Opened by the app only. -->
        <activity
            android:name=".GuideActivity"
            android:exported="false" />

        <!-- Opened by the app only. -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shown by the notification only. Not exported: nothing outside the app can open it. -->
        <activity
            android:name=".ConfirmCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="" />

        <receiver
            android:name=".CancelReceiver"
            android:exported="false" />

        <!-- A button on a reminder notification. Only the app's own immutable PendingIntents reach it. -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />

        <!--
          Keeps the last day of notifications on this phone, for "what did I get".
          Runs only once the user grants notification access in the system settings.
        -->
        <service
            android:name=".NotificationCollector"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".CompanionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
