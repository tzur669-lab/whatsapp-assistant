<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the assistant's Worker. HTTPS only, every request signed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hold-to-record voice messages. Asked for at the first press, not at install. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Match a name to a contact. Read on the phone, never sent anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Place the call after the tap, from this SIM. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The call request appears over the lock screen; Android 14+ may ask for it in settings. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Both are used when present; neither is required to install. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Nothing here is backed up or transferred: the chat history, the device id
      and the Keystore alias stay on this phone (data_extraction_rules.xml).
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_assistant"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by the app only. -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shown by the notification only. Not exported: nothing outside the app can open it. -->
        <activity
            android:name=".ConfirmCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="" />

        <receiver
            android:name=".CancelReceiver"
            android:exported="false" />

        <!-- A button on a reminder notification. Only the app's own immutable PendingIntents reach it. -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />

        <service
            android:name=".CompanionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
