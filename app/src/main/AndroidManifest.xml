<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fetch a call request and report how it ended. HTTPS only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Match a name to a contact. Read on the phone, never sent anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Place the call after the tap, from this SIM. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The request appears over the lock screen; Android 14+ may ask for it in settings. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_call"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown by the notification only. Not exported: nothing outside the app can open it. -->
        <activity
            android:name=".ConfirmCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="" />

        <receiver
            android:name=".CancelReceiver"
            android:exported="false" />

        <service
            android:name=".CompanionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
