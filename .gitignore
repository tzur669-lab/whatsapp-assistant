# secrets — never commit
.dev.vars
.dev.vars.*
.env
.env.*
secrets/

# build / tooling
node_modules/
dist/
.wrangler/
coverage/
*.tsbuildinfo

# os / editor
.DS_Store
Thumbs.db
.idea/

# Eval run logs — regenerated by `pnpm eval`, not worth committing.
eval-*.log

# Eval recordings are run artifacts: a checkpoint rewritten every case, so a
# partial one would land in every commit made while a run is going. A recording
# worth keeping as a certification record is added explicitly with `git add -f`.
test/evals/recordings/
