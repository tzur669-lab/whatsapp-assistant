{
  "name": "wa-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run --exclude test/unit/core/cpu-budget.test.ts && pnpm test:timing",
    "test:timing": "vitest run test/unit/core/cpu-budget.test.ts",
    "test:watch": "vitest",
    "eval": "tsx test/evals/run-evals.ts",
    "bench": "tsx scripts/bench-turn.ts",
    "dev": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "eval:agent": "tsx test/evals/run-agent-evals.ts"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0",
    "yaml": "^2.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vite": "^6.4.3",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5"
    }
  }
}
