{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Migrations are imported as text so they ship inside the bundle.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": false }],

  // No secrets here. Secrets are set with `wrangler secret put` (PLAN §7.2).
  "env": {
    "staging": {
      "name": "wa-assistant-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        // Which channel the assistant speaks on (PLAN §6.18): app | whatsapp | off.
        // Vars are not inherited between environments; set it in each.
        "CHANNEL": "app",
        // The tool-calling agent (PLAN §6.19): on | off. On only once Groq Zero
        // Data Retention is enabled, since the agent sends calendar titles.
        "AGENT": "off",
        "WA_PHONE_NUMBER_ID": "",
        // The OAuth client in the Google Cloud project `tzur-call-companion`. Not a secret.
        "GOOGLE_CLIENT_ID": "1002488382572-j5hod9r4viunvs95j716nb2vn2uv9ecd.apps.googleusercontent.com",
        // Must match the redirect URI registered with Google, exactly.
        "PUBLIC_BASE_URL": "https://wa-assistant-staging.moneytime-pro-api.workers.dev"
      },
      "durable_objects": {
        "bindings": [{ "name": "ASSISTANT", "class_name": "AssistantDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AssistantDO"] }],
      // 03:30 UTC: retention, expiries, re-arm. Hourly: the digest decides
      // for itself whether this is its hour (PLAN §6.12).
      "triggers": { "crons": ["30 3 * * *", "0 * * * *"] }
    },
    "production": {
      "name": "wa-assistant",
      "vars": {
        "ENVIRONMENT": "production",
        // Unchanged until the app has had its two weeks on staging (PLAN §6.18).
        "CHANNEL": "whatsapp",
        "AGENT": "off",
        "WA_PHONE_NUMBER_ID": "",
        "GOOGLE_CLIENT_ID": "",
        // Must match the redirect URI registered with Google, exactly.
        "PUBLIC_BASE_URL": ""
      },
      "durable_objects": {
        "bindings": [{ "name": "ASSISTANT", "class_name": "AssistantDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AssistantDO"] }],
      // 03:30 UTC: retention, expiries, re-arm. Hourly: the digest decides
      // for itself whether this is its hour (PLAN §6.12).
      "triggers": { "crons": ["30 3 * * *", "0 * * * *"] }
    }
  }
}
